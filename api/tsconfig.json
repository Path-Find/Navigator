{
  // The root tsconfig only covers `src` and `vite.config.ts`, so nothing described
  // the Vercel Functions in this directory. Vercel compiled them with its own
  // defaults and reported `process` as undefined on every build — non-fatal noise
  // that shipped alongside a genuinely broken deploy on 2026-07-31 and hid it.
  // `nodenext` matches what Vercel already does, which is why relative imports
  // here need explicit `.js` extensions.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["**/*.ts"]
}
